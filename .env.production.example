# Configuración por equipo. No incluir .env en Git.
# Producción: copiar a .env.production y completar valores propios.
AMYB_ENV_FILE=.env.production
COMPOSE_PROJECT_NAME=amyb-production
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
POSTGRES_VOLUME=amyb_production_pgdata
POSTGRES_PORT=5433
POSTGRES_USER=amyb
POSTGRES_DB=amyb
POSTGRES_PASSWORD=
DATABASE_URL=
NODE_ENV=production
PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://tienda.example.com
FRONTEND_URL=https://tienda.example.com
INIT_DEMO_DATA=false
INIT_ADMIN=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEBPAY_ENVIRONMENT=production
WEBPAY_BASE_URL=https://webpay3g.transbank.cl
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY_SECRET=
WEBPAY_RETURN_URL=https://tienda.example.com/webpay/return
FACTO_BASE_URL=https://apifacto.com/v1
FACTO_SANDBOX=false
FACTO_ACCOUNT_ID=
FACTO_EMISOR_RUT=
FACTO_EMISOR_RAZON_SOCIAL=
FACTO_EMISOR_GIRO=
FACTO_EMISOR_DIRECCION=
FACTO_CLIENT_ID=
FACTO_CLIENT_SECRET=
FACTO_USERNAME=
FACTO_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Amyb Distribuidora
