# Configuración por equipo. No incluir .env en Git.
# Desarrollo rápido: npm run configure genera .env y backend/.env.
AMYB_ENV_FILE=.env
COMPOSE_PROJECT_NAME=amyb
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
POSTGRES_VOLUME=amyb_pgdata
POSTGRES_PORT=5433
POSTGRES_USER=amyb
POSTGRES_DB=amyb
POSTGRES_PASSWORD=
DATABASE_URL=
NODE_ENV=development
PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
FRONTEND_URL=http://localhost:8080
INIT_DEMO_DATA=true
INIT_ADMIN=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
WEBPAY_ENVIRONMENT=integration
WEBPAY_BASE_URL=https://webpay3gint.transbank.cl
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY_SECRET=
WEBPAY_RETURN_URL=http://localhost:8080/webpay/return
FACTO_BASE_URL=https://apifacto.com/v1
FACTO_SANDBOX=true
FACTO_ACCOUNT_ID=
FACTO_EMISOR_RUT=
FACTO_EMISOR_RAZON_SOCIAL=
FACTO_EMISOR_GIRO=
FACTO_EMISOR_DIRECCION=
FACTO_CLIENT_ID=
FACTO_CLIENT_SECRET=
FACTO_USERNAME=
FACTO_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Amyb Distribuidora
